# Credentials and environment files
.env
.env.*
docker.env
**/privatecredentials*
**/*private-credentials*
!/.env.example
!/docker.env.example

# Local databases and runtime data; only the synthetic demo dataset enters the image
data/*
!data/issues_demo.json
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db

# Generated output, backups, caches, and local environments
logs/
backups/
audit/
evaluation/
release/
.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.jsonl
.pytest_cache/
.mypy_cache/
.ruff_cache/
.docker-cache/
docker-cache/

# Source-control and editor metadata
.git/
.gitignore
.gitattributes
.github/
.idea/
.vscode/

# Files not required by the runtime image
tests/
scripts/
bootstrap_windows.ps1
README.md
compose*.yaml
