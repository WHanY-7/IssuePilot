# Copy to .env on your own computer. Do not commit .env.
ISSUEPILOT_AUTH_SECRET=replace-with-long-random-secret
QWEN_API_KEY=replace-with-your-api-key
QWEN_MODEL=qwen3.8-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional read-only local similar-issue retrieval. Default is false so the
# existing triage result and Worker behavior remain unchanged.
ISSUEPILOT_SIMILARITY_ENABLED=false

# Optional sandbox-only GitHub writeback. Leave both values empty to disable it.
# The repository value must be exactly WHanY-7/IssuePilot-Sandbox; no other
# repository is accepted. Use a narrowly scoped token only in your local .env.
ISSUEPILOT_GITHUB_TEST_REPO=
ISSUEPILOT_GITHUB_TOKEN=
