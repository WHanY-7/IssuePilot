# Copy this file to docker.env. Never commit docker.env.
# Use a unique value of at least 20 characters.
ISSUEPILOT_AUTH_SECRET=replace-with-a-long-random-container-secret

# Required only when the Worker should perform a real Qwen triage.
QWEN_API_KEY=replace-with-your-qwen-api-key
QWEN_MODEL=qwen3.8-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional read-only local similar-issue retrieval; disabled by default.
ISSUEPILOT_SIMILARITY_ENABLED=false

# Optional sandbox-only GitHub writeback. Keep both empty to disable it.
ISSUEPILOT_GITHUB_TEST_REPO=
ISSUEPILOT_GITHUB_TOKEN=
